# Copy this file to `.env.local` and fill in your key.
# Leave LLM_API_KEY empty to run in demo mode (heuristic engine, no API calls).

# openai | azure | anthropic | gemini
# "openai" also works for any OpenAI-compatible endpoint (OpenRouter, Groq, Together, Ollama, vLLM…) via LLM_BASE_URL.
LLM_PROVIDER=openai

# Your API key (placeholder)
LLM_API_KEY=

# Model name (Azure: your deployment name)
LLM_MODEL=gpt-4o

# Optional: custom endpoint
#   OpenAI-compatible: https://openrouter.ai/api/v1   |   http://localhost:11434/v1 (Ollama)
#   Azure OpenAI:      https://<resource>.openai.azure.com
LLM_BASE_URL=

# Optional
AZURE_OPENAI_API_VERSION=2024-10-21
LLM_TEMPERATURE=0.4
